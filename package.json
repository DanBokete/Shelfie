{
  "name": "shelfie",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "vite build",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mock:generate": "tsx scripts/generate.ts",
    "demo": "tsx --env-file=.env scripts/demo.ts",
    "demo:load": "tsx --env-file=.env scripts/demo.ts load",
    "demo:accuracy": "tsx --env-file=.env scripts/demo.ts accuracy",
    "demo:snapshot": "tsx --env-file=.env scripts/demo.ts snapshot",
    "demo:restore": "tsx --env-file=.env scripts/demo.ts restore",
    "db:start": "supabase start",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "google-auth-library": "11.3.3",
    "heic-to": "^1.6.7",
    "html-to-text": "10.0.1",
    "html5-qrcode": "^2.3.8",
    "imapflow": "2.9.1",
    "libmime": "5.6.3",
    "mailparser": "3.12.4",
    "nitro": "3.0.260610-beta",
    "nodemailer": "^10.3.1",
    "papaparse": "^5.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.18",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/eslint-config": "0.4.0",
    "@types/html-to-text": "9.0.4",
    "@types/mailparser": "3.9.0",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^18.0.9",
    "eslint": "^9.20.0",
    "playwright": "^1.65.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
