# Server-only. All database and storage access goes through server routes, so
# no Supabase key is exposed to the browser.
ANTHROPIC_API_KEY=
SHELFIE_MODEL=claude-sonnet-5-5           # switch to claude-opus-5-5 if extraction accuracy is poor
SUPABASE_URL=http://127.0.0.1:55321       # `supabase status` prints these for the local stack
SUPABASE_SERVICE_ROLE_KEY=
DEMO_MODE=false                           # true = serve cached AI results from data/cache, no API calls

# Sending requests and reading replies: "Connect Gmail" on the Settings page. See README, "Connect Gmail".
GOOGLE_CLIENT_ID=                         # a Google Cloud OAuth client of type "Web application"
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=                     # encrypts the stored Google token: `openssl rand -base64 32`
# Or, without connecting: a Google app password from myaccount.google.com/apppasswords (needs 2-Step Verification)
GMAIL_APP_PASSWORD=

# --- Optional -------------------------------------------------------------------------
# Postmark sending, instead of Gmail: only for an address on your own domain.
POSTMARK_SERVER_TOKEN=                    # a Postmark server's API token
# Reply scanning (Postmark inbound). Both can be set on the Settings page instead, which wins.
INBOUND_EMAIL_ADDRESS=                    # the Postmark inbound address, e.g. abc123@inbound.postmarkapp.com
INBOUND_WEBHOOK_SECRET=                   # any long random string; Settings can make one for you
# Telegram alerts to the owner. See README, "Telegram alerts".
TELEGRAM_BOT_TOKEN=                       # from @BotFather, e.g. 123456789:AA...
TELEGRAM_CHAT_ID=                         # the owner's chat with the bot, e.g. 987654321
APP_URL=http://localhost:3000             # base of the links in alerts; use the deployed or tunnel URL for a phone
# A different Claude API endpoint, e.g. a proxy. Leave unset for https://api.anthropic.com.
SHELFIE_ANTHROPIC_BASE_URL=
