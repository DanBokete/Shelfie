# Server-only. All database and storage access goes through server routes, so
# no Supabase key is exposed to the browser.
ANTHROPIC_API_KEY=
SHELFIE_MODEL=claude-sonnet-5-5           # switch to claude-opus-5-5 if extraction accuracy is poor
SUPABASE_URL=http://127.0.0.1:55321       # `supabase status` prints these for the local stack
SUPABASE_SERVICE_ROLE_KEY=
# Reply scanning: Postmark inbound webhook. See README, "Reading supplier replies".
INBOUND_EMAIL_ADDRESS=                    # the Postmark inbound address, e.g. abc123@inbound.postmarkapp.com
INBOUND_WEBHOOK_SECRET=                   # any long random string; put it in the webhook URL as ?secret=
# Telegram alerts to the owner. See README, "Telegram alerts".
TELEGRAM_BOT_TOKEN=                       # from @BotFather, e.g. 123456789:AA...
TELEGRAM_CHAT_ID=                         # the owner's chat with the bot, e.g. 987654321
APP_URL=http://localhost:3000             # base of the links in alerts; use the deployed or tunnel URL for a phone
DEMO_MODE=false                           # true = serve cached AI results from data/cache, no API calls
